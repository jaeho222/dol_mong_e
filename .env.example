# 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 절대 커밋 금지)

# Claude API — 비워두면 자동으로 데모(mock) 모드
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# auto | claude | mock
AGENT_MODE=auto
AGENT_MAX_TURNS=6

# 데이터 — 실제 데이터 준비되면 data/processed/region_metrics.csv 로 변경
REGION_METRICS_PATH=data/sample/region_metrics.csv

# 공공데이터포털(data.go.kr) 인증키 — data/build 스크립트용
DATA_GO_KR_KEY=
# 제주데이터허브 API 키 — data/build 스크립트용
JEJU_DATAHUB_KEY=
