# 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 절대 커밋 금지)

# Claude API — 비워두면 자동으로 데모(mock) 모드
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# auto | claude | mock
AGENT_MODE=auto
AGENT_MAX_TURNS=5
AGENT_MAX_TOKENS=1500
AGENT_TIMEOUT=25
# 공개 링크에서 키 남용 막기: IP당 1분에 자유 질문 몇 개까지
AGENT_RATE_PER_MIN=8

# 데이터 — Supabase에서 내보낸 실데이터 (더미로 돌리려면 data/sample/region_metrics.csv)
REGION_METRICS_PATH=data/processed/region_metrics.csv

# 공공데이터포털(data.go.kr) 인증키 — data/build 스크립트용
DATA_GO_KR_KEY=
# 제주데이터허브 API 키는 Supabase 시크릿 JEJU_HUB_KEY 로 넣는다 (supabase/functions/README.md)

# Supabase Postgres 연결 문자열 — data/build/export_supabase.py 용 (대시보드 → Connect → Session pooler)
SUPABASE_DB_URL=
